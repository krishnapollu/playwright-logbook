{
  "name": "playwright-logbook-vscode",
  "displayName": "Playwright Logbook",
  "description": "Browse Playwright runs, investigate failures and retries, compare test history, and import CI results.",
  "version": "0.2.21",
  "publisher": "krishnapollu",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F3D2E",
    "theme": "dark"
  },
  "keywords": [
    "playwright",
    "test history",
    "test results",
    "flaky tests",
    "logbook"
  ],
  "homepage": "https://github.com/krishnapollu/playwright-logbook/tree/main/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/krishnapollu/playwright-logbook/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read workspace-contained history and open workspace-contained source. External mappings require trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "This extension reads local desktop files only."
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "logbook",
          "title": "Logbook",
          "icon": "media/logbook.svg"
        }
      ]
    },
    "views": {
      "logbook": [
        {
          "id": "logbook.recentRuns",
          "name": "Recent Runs",
          "type": "webview"
        },
        {
          "id": "logbook.tests",
          "name": "Tests"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "logbook.recentRuns",
        "contents": "Open a local workspace folder to inspect Logbook history or import a CI run bundle. The reporter records local runs; importing a ZIP adds exported runs to that workspace's local history.\n[Import ZIP to Local History\u2026](command:logbook.importBundle)",
        "when": "!workspaceFolderCount"
      }
    ],
    "commands": [
      {
        "command": "logbook.analyze",
        "title": "Logbook: Analyze Selected Test"
      },
      {
        "command": "logbook.importBundle",
        "title": "Logbook: Import ZIP to Local History\u2026",
        "icon": "$(cloud-download)"
      },
      {
        "command": "logbook.filterTests",
        "title": "Logbook: Filter Runs and Tests",
        "icon": "$(filter)"
      },
      {
        "command": "logbook.fetchCiRuns",
        "title": "Logbook: Fetch CI Run from GitHub Actions…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "logbook.chooseImport",
        "title": "Logbook: Import Runs…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "logbook.filterSpecFile",
        "title": "Logbook: Filter Tests in This Spec File"
      },
      {
        "command": "logbook.filterCurrentTest",
        "title": "Logbook: Filter This Test"
      },
      {
        "command": "logbook.expandAll",
        "title": "Logbook: Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "logbook.collapseAll",
        "title": "Logbook: Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "logbook.clearTestFilter",
        "title": "Logbook: Clear Test Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "logbook.refresh",
        "title": "Logbook: Refresh History",
        "icon": "$(refresh)"
      },
      {
        "command": "logbook.selectStore",
        "title": "Logbook: Select History Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "logbook.configureSource",
        "title": "Logbook: Configure Source Mapping"
      },
      {
        "command": "logbook.openSource",
        "title": "Logbook: Open Recorded Source Location"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "logbook.chooseImport",
          "when": "view == logbook.recentRuns && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "logbook.expandAll",
          "when": "view == logbook.recentRuns",
          "group": "navigation"
        },
        {
          "command": "logbook.collapseAll",
          "when": "view == logbook.recentRuns",
          "group": "navigation"
        },
        {
          "command": "logbook.clearTestFilter",
          "when": "view == logbook.recentRuns && logbook.hasTestFilter",
          "group": "navigation"
        },
        {
          "command": "logbook.refresh",
          "when": "view == logbook.recentRuns",
          "group": "navigation"
        },
        {
          "command": "logbook.selectStore",
          "when": "view == logbook.recentRuns",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "logbook.filterSpecFile",
          "when": "resourceScheme == file && resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/",
          "group": "3_testing"
        }
      ],
      "editor/context": [
        {
          "command": "logbook.filterCurrentTest",
          "when": "resourceScheme == file && resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/",
          "group": "2_testing"
        }
      ]
    },
    "configuration": {
      "title": "Logbook",
      "properties": {
        "logbook.historyPath": {
          "type": "string",
          "default": ".logbook",
          "scope": "resource",
          "description": "History folder relative to this workspace folder. External stores require workspace trust."
        },
        "logbook.sourceRoot": {
          "type": "string",
          "default": ".",
          "scope": "resource",
          "description": "Mapped checkout root. Recorded paths and historical lines may differ from the current checkout."
        },
        "logbook.autoRefresh": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Refresh after committed history changes without switching the selected execution."
        },
        "logbook.historyLimit": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "scope": "resource",
          "description": "Initial history page size."
        },
        "logbook.ciRepository": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "GitHub owner/repo containing Logbook CI artifacts. Fetch is always explicit."
        },
        "logbook.ciArtifactName": {
          "type": "string",
          "default": "logbook-run",
          "scope": "resource",
          "description": "Exact GitHub Actions artifact name uploaded by CI."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnapollu/playwright-logbook.git",
    "directory": "packages/vscode"
  }
}
