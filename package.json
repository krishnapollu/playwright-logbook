{
  "name": "playwright-logbook",
  "version": "0.3.1",
  "description": "A local, self-contained Playwright report with run history and flaky-test tracking",
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnapollu/playwright-logbook.git"
  },
  "homepage": "https://github.com/krishnapollu/playwright-logbook#readme",
  "bugs": {
    "url": "https://github.com/krishnapollu/playwright-logbook/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./history-reader": {
      "types": "./dist/historyreader.d.ts",
      "import": "./dist/historyreader.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bundles": {
      "types": "./dist/bundles/index.d.ts",
      "import": "./dist/bundles/index.js"
    }
  },
  "bin": {
    "playwright-logbook": "dist/cli/bin.js",
    "logbook": "dist/cli/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "docs/img/logo.svg",
    "docs/img/report-dark.png",
    "docs/img/report-light.png",
    "docs/RUN-BUNDLES.md",
    "docs/CI.md",
    "docs/CLI.md",
    "docs/SCHEMA.md",
    "docs/ADAPTERS.md"
  ],
  "keywords": [
    "playwright",
    "reporter",
    "test-reporting",
    "flaky-tests",
    "ci",
    "sharding"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/index.cjs && npm run build --prefix packages/vscode",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && npm run typecheck --prefix packages/vscode",
    "lint": "eslint .",
    "test": "vitest run",
    "test:vscode": "npm run build --prefix packages/vscode && node packages/vscode/test/run.mjs",
    "demo": "npm run build && node scripts/make-demo.mjs",
    "test:e2e": "npm run demo && playwright test --config=e2e/playwright.config.ts",
    "shots": "npm run demo && node scripts/make-shots.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "test:release": "node scripts/release-smoke.mjs",
    "test:release:views": "node scripts/release-views.mjs",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "1.95.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
